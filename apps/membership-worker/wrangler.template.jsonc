// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "test-finishline-membership-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local",
    "DEBUG_DELIVERY": "true",
    // M0 / Solo profile (test-finishline ships single-user): caps each account at its one
    // personal organization. Set "false" to restore the full multi-tenant
    // baseline. Must match api-edge/identity-worker. See specs/profiles/solo-m0.md.
    "SOLO_MODE": "true"
  },
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "true"
      }
    },
    "stage": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "stage",
        "DEBUG_DELIVERY": "true",
        "SOLO_MODE": "true"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "test-finishline-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "services": [
        // @cycle-break:membership-worker->policy-worker:ewogICAgICAgICAgImJpbmRpbmciOiAiUE9MSUNZX1dPUktFUiIsCiAgICAgICAgICAic2VydmljZSI6ICJ0ZXN0LWZpbmlzaGxpbmUtcG9saWN5LXdvcmtlci1zdGFnZSIKICAgICAgICB9LA==
        // @cycle-break:membership-worker->billing-worker:ewogICAgICAgICAgImJpbmRpbmciOiAiQklMTElOR19XT1JLRVIiLAogICAgICAgICAgInNlcnZpY2UiOiAidGVzdC1maW5pc2hsaW5lLWJpbGxpbmctd29ya2VyLXN0YWdlIgogICAgICAgIH0s
        // @cycle-break:membership-worker->notifications-worker:ewogICAgICAgICAgImJpbmRpbmciOiAiTk9USUZJQ0FUSU9OU19XT1JLRVIiLAogICAgICAgICAgInNlcnZpY2UiOiAidGVzdC1maW5pc2hsaW5lLW5vdGlmaWNhdGlvbnMtd29ya2VyLXN0YWdlIgogICAgICAgIH0=
      ]
    },
    "prod": {
      "workers_dev": false,
      "vars": {
        "ENVIRONMENT": "prod",
        "DEBUG_DELIVERY": "false",
        "SOLO_MODE": "true"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "test-finishline-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "services": [
        // @cycle-break:membership-worker->policy-worker:ewogICAgICAgICAgImJpbmRpbmciOiAiUE9MSUNZX1dPUktFUiIsCiAgICAgICAgICAic2VydmljZSI6ICJ0ZXN0LWZpbmlzaGxpbmUtcG9saWN5LXdvcmtlci1wcm9kIgogICAgICAgIH0s
        // @cycle-break:membership-worker->billing-worker:ewogICAgICAgICAgImJpbmRpbmciOiAiQklMTElOR19XT1JLRVIiLAogICAgICAgICAgInNlcnZpY2UiOiAidGVzdC1maW5pc2hsaW5lLWJpbGxpbmctd29ya2VyLXByb2QiCiAgICAgICAgfSw=
        // @cycle-break:membership-worker->notifications-worker:ewogICAgICAgICAgImJpbmRpbmciOiAiTk9USUZJQ0FUSU9OU19XT1JLRVIiLAogICAgICAgICAgInNlcnZpY2UiOiAidGVzdC1maW5pc2hsaW5lLW5vdGlmaWNhdGlvbnMtd29ya2VyLXByb2QiCiAgICAgICAgfQ==
      ]
    }
  }
}
